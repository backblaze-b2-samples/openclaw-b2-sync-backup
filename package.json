{
  "name": "openclaw-b2-backup",
  "version": "0.1.8",
  "description": "Sync and backup OpenClaw state to Backblaze B2",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsdown src/index.ts index.ts --format esm --dts --out-dir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync-from-monorepo": "./scripts/sync.sh pull",
    "sync-to-monorepo": "./scripts/sync.sh push"
  },
  "dependencies": {
    "croner": "^10.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "devDependencies": {
    "openclaw": ">=2026.0.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "keywords": [
    "openclaw",
    "backblaze",
    "b2",
    "backup",
    "sync",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/backblaze-b2-samples/openclaw-b2-sync-backup"
  }
}
